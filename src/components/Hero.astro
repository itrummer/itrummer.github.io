---
import { site } from '../data/site';
import bioRaw from '../content/pages/about.md?raw';

const bioParagraphs = bioRaw
  .trim()
  .split(/\n\n+/)
  .filter((p) => p.trim().length > 0);
---
<section id="about" class="section hero">
  <div class="container">
    <div class="hero-grid">
      <img
        class="hero-photo"
        src={site.photoPath}
        alt={site.name}
        width="200"
        height="200"
      />
      <div>
        <h1 class="hero-name">{site.name}</h1>
        <p class="hero-title">{site.title}</p>
        <div class="hero-bio">
          {bioParagraphs.map((p) => (
            <p>{p}</p>
          ))}
        </div>
        <div class="profile-links">
          <a href={`mailto:${site.email}`}>Email</a>
          <a href={site.cvPath}>CV</a>
          <a href={site.github} rel="noopener noreferrer">GitHub</a>
          <a href={site.linkedin} rel="noopener noreferrer">LinkedIn</a>
        </div>
      </div>
    </div>
  </div>
</section>
