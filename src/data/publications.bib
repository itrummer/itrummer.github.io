   issn = {2150-8097},
   issue = {8},
   journal = {PVLDB},
   pages = {1754-1767},
   title = {SemBench: A Benchmark for Semantic Query Processing Engines},
   volume = {19},
   url = {https://doi.org/10.14778/3811243.3811249},
   year = {2026}
}
